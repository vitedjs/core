{
  "name": "@vited/core",
  "version": "0.1.0",
  "description": "Core Vite integration and documentation pipeline for Vited",
  "keywords": [
    "vite",
    "react",
    "documentation",
    "mdx"
  ],
  "homepage": "https://github.com/vitedjs/core#readme",
  "bugs": {
    "url": "https://github.com/vitedjs/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitedjs/core.git"
  },
  "funding": "https://ko-fi.com/guoyunhe",
  "license": "MPL-2.0",
  "author": {
    "name": "Guo Yunhe",
    "email": "i@guoyunhe.me"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.14.0",
      "onFail": "error"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "predev": "pnpm build && pnpm --dir ../cli build && pnpm --dir ../theme-mantine build",
    "dev": "vited dev",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.2",
    "sanitize-html": "^2.17.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@guoyunhe/editorconfig": "^0.3.0",
    "@guoyunhe/oxfmt-config": "^1.1.0",
    "@types/node": "^22.15.30",
    "@types/sanitize-html": "^2.16.0",
    "@vited/cli": "link:../cli",
    "@vited/theme-mantine": "link:../theme-mantine",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-config-recommended": "^1.1.0",
    "tsdown": "^0.23.2",
    "typescript": "^5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,vue}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.css": "oxfmt --write",
    "*.{json,jsonc,scss,less,htm,html,md,mdx,yaml,yml}": "oxfmt --write"
  }
}
