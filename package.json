{
  "name": "@vited/core",
  "version": "0.1.0",
  "description": "Core Vite integration and documentation pipeline for Vited",
  "keywords": ["vite", "react", "documentation", "mdx"],
  "homepage": "https://github.com/vitedjs/core#readme",
  "bugs": {
    "url": "https://github.com/vitedjs/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitedjs/core.git"
  },
  "license": "MIT",
  "author": {
    "name": "Guo Yunhe",
    "email": "i@guoyunhe.me"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.14.0",
      "onFail": "error"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": ["dist", "CHANGELOG.md", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.2",
    "sanitize-html": "^2.17.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@vited/cli": "link:../cli",
    "@vited/theme-mantine": "link:../theme-mantine",
    "@types/node": "^22.15.30",
    "@types/sanitize-html": "^2.16.0",
    "tsdown": "^0.23.2",
    "typescript": "^5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
