{
  "name": "@vited/core",
  "version": "0.1.2",
  "description": "Core Vite integration and documentation pipeline for Vited",
  "keywords": [
    "documentation",
    "mdx",
    "react",
    "vite"
  ],
  "homepage": "https://github.com/vitedjs/core#readme",
  "bugs": {
    "url": "https://github.com/vitedjs/core/issues"
  },
  "license": "MPL-2.0",
  "author": {
    "name": "Guo Yunhe",
    "email": "i@guoyunhe.me",
    "url": "https://guoyunhe.me/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitedjs/core.git"
  },
  "funding": "https://ko-fi.com/guoyunhe",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vited dev",
    "docs:build": "vited build",
    "docs:dev": "vited dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "predev": "pnpm build && pnpm --dir ../cli build && pnpm --dir ../theme-mantine build",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@vitejs/plugin-react": "^6.1.2",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.2",
    "md-url-path": "^1.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-link-rewrite": "^1.0.7",
    "sanitize-html": "^2.18.1",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@guoyunhe/oxfmt-config": "^1.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vited/cli": "link:../cli",
    "@vited/theme-mantine": "link:../theme-mantine",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.90.0",
    "oxlint-config-recommended": "^1.2.0",
    "tsdown": "^0.23.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vite": "^8.3.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,vue}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.css": "oxfmt --write",
    "*.{json,jsonc,scss,less,htm,html,md,mdx,yaml,yml}": "oxfmt --write"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.16.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^26.13.0 || ^24.22.2 || ^22.23.4"
  }
}
